# ===== SERVER ONLY — NEVER COMMIT THIS FILE =====
# Copy to .env and fill in real values.

PORT=8080
NODE_ENV=development

# Public URL of this API (used for CORS). Add your Vercel URL + localhost.
CLIENT_URL=http://localhost:5173

# Secret used to sign login sessions (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ===== SUPABASE (server only) =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: used ONLY by `npm run init-db` to create tables automatically.
# Either a database connection string (preferred) ...
SUPABASE_DB_URL=
# ... or a Supabase personal access token (sbp_...) for the Management API.
SUPABASE_ACCESS_TOKEN=

# ===== GOOGLE GEMINI (server only, never exposed to the browser) =====
GEMINI_API_KEY=

# Bootstrap admin account created by init-db
ADMIN_EMAIL=admin@bustracker.dev
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin

# Move demo buses along their routes every tick (set false for real GPS only)
SIMULATE_BUSES=true
SIMULATION_INTERVAL_MS=5000
